# Database
# Defaults to a local SQLite file when unset. To use PostgreSQL, set a full URL,
# e.g. postgresql://user:password@localhost:5432/um_crm
DATABASE_URL=sqlite:///./um_crm.db

# Agent LLM (Ilmu AI) model used by the customer-service agent
AGENT_CHAT_MODEL=ilmu-glm-5.1

# Google OAuth2 Credentials
# Get these from Google Cloud Console (https://console.cloud.google.com/)
# Create OAuth 2.0 Client ID credentials for Web application
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# JWT Secret (change in production - use a strong random string)
JWT_SECRET_KEY=your-secure-random-secret-key-here

# OpenRouter AI (LLM gateway)
# Get API key from https://openrouter.ai/
OPENROUTER_API_KEY=your-api-key-here
# Ilmu AI API Key
ILMU_API_KEY=your-ilmu-api-key-here
