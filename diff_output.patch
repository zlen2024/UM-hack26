+          >
+            <ForceGraph2D
+              width={dimensions.width}
+              height={dimensions.height}
+              graphData={graphData}
+              nodeLabel="label"
+              nodeColor={(node: any) => selectedNode?.id === node.id ? '#4f46e5' : '#3b82f6'}
+              nodeRelSize={6}
